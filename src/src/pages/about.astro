---
/**
 * 关于页：公司简介 + 软著证书墙 + 发展时间线（设计稿 §7 关于页 / 实施计划任务 10）
 *
 * - 简介复用旧站 data.json 的 aboutdesc / aboutdetail 文案扩写；模板作者遗留
 *   信息段（aboutMeHeadline / aboueMeDetails）一律不出现。
 * - 软著墙读 data/certificates.json（名称已按证书实拍逐字核对），图经
 *   import.meta.glob 构建期解析，图片服务压缩转 webp（与产品页 banner 同手法）。
 * - 时间线日志格式：只写有依据的事件——2016 成立为拍板硬事实；软著 10 项
 *   为当前硬事实，登记年份证书图未核实，不编造具体年份事件。
 *
 * GEO（设计稿 §8）：全部正文服务端直出；Organization JSON-LD（sameAs 仅 Gitee）；
 * title/description/canonical 由 Base 直出，每页唯一。
 */
import { Image, type ImageMetadata } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TermWindow from '../components/TermWindow.astro';
import certificates from '../../data/certificates.json';

// 证书图文件名存于 certificates.json，构建期 glob 一次性解析到图片模块
const certImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/certs/*.jpg');

// 预解析每张证书图（缺图则 undefined，渲染时不显图）
const certs = await Promise.all(
  certificates.map(async (c) => {
    const module = certImages[`../../assets/certs/${c.file}`];
    return { ...c, img: module ? (await module()).default : undefined };
  }),
);

// 公司信息（与联系页同源）：电话 / 邮箱取旧站 data.json 公司字段原文，
// 地址按拍板口径不含房间号；开源只用 Gitee 表述。
const GITEE = 'https://gitee.com/qnsoft';

// JSON-LD：Organization（成立年份为拍板硬事实；sameAs 只写 Gitee）
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '石家庄青柠软件技术有限公司',
  alternateName: '青柠软件',
  url: new URL('/', Astro.site).href,
  foundingDate: '2016',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '河北省石家庄市裕华区河北地质大学综合楼',
    addressLocality: '石家庄市',
    addressRegion: '河北省',
    addressCountry: 'CN',
  },
  sameAs: [GITEE],
};
---

<Base
  title="关于我们 — 石家庄青柠软件技术有限公司"
  description="青柠软件（石家庄青柠软件技术有限公司）成立于 2016 年，专注软件平台、移动应用与物联网开发，服务政府机关、企事业单位与个人定制客户，累计登记软件著作权 10 项。本页含公司简介、软著证书墙与发展时间线。"
  pageName="关于"
>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <main class="qn-about">
    <!-- 面屑：~ / about -->
    <nav class="qn-crumbs" aria-label="面包屑">
      <a href="/">~</a><span class="qn-csep" aria-hidden="true"> / </span
      ><span class="qn-chere">about</span>
    </nav>

    <h1 class="qn-title">关于青柠软件</h1>
    <p class="qn-intro">专业软件开发团队，专注于行业软件、平台软件开发和运营。</p>

    <!-- 公司简介：aboutdetail 复用扩写 -->
    <section class="qn-block">
      <h2 class="qn-sec">WHOAMI</h2>
      <div class="qn-prose">
        <p>
          青柠软件（石家庄青柠软件技术有限公司）成立于 2016
          年，专注于软件平台开发、移动应用开发、物联网等领域，是一家面向行业客户的软件开发团队。
        </p>
        <p>
          服务客户涵盖政府机关、企事业单位及个人定制等相关需求，服务行业涵盖交通、电力、智能制造、电商销售等多个领域。为紧跟互联网发展和科技进步，公司不断投入学习和研发成本，力求公司业务保持领先水平。
        </p>
        <p>
          公司累计登记软件著作权 10
          项（见下方证书墙），方向覆盖交通、食品加工、电商、物流配送、物联网组态等行业；自主研发产品包括智尚通行（智慧社区平台）、远程医疗
          PACS 系统等，沉淀 6 套行业解决方案，开源项目托管于 <a
            href={GITEE}
            target="_blank"
            rel="noopener noreferrer">Gitee</a
          >。
        </p>
      </div>
    </section>

    <!-- 软著证书墙：10 张，标签为证书实拍上的软件全称 -->
    <section class="qn-block">
      <h2 class="qn-sec">CERTS</h2>
      <p class="qn-sec-note">已登记软件著作权 {certs.length} 项，证书如下：</p>
      <div class="qn-certs">
        {
          certs.map((c) => (
            <figure class="qn-cert">
              {c.img && (
                <Image
                  src={c.img}
                  alt={`软件著作权证书：${c.name}`}
                  width={220}
                  densities={[1, 2]}
                  format="webp"
                  loading="lazy"
                />
              )}
              <figcaption>{c.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- 发展时间线：日志格式，只写有依据的事件 -->
    <section class="qn-block">
      <h2 class="qn-sec">HISTORY</h2>
      <TermWindow title="$ cat history.log">
        <ol class="qn-log">
          <li>
            <span class="qn-log-time">[2016]</span>
            公司成立，专注行业软件、平台软件开发和运营。
          </li>
          <li>
            <span class="qn-log-time">[至今]</span>
            累计登记软件著作权 10 项，覆盖交通、食品加工、电商、物联网等行业。
          </li>
        </ol>
      </TermWindow>
    </section>
  </main>
</Base>

<style>
  .qn-about {
    max-width: 1020px;
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  .qn-crumbs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 32px;
  }

  .qn-chere {
    color: var(--text);
  }

  .qn-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.3;
  }

  .qn-intro {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--text-dim);
  }

  .qn-block {
    margin-top: 44px;
  }

  /* man 手册式段头（WHOAMI/CERTS/HISTORY），与产品页同语言 */
  .qn-sec {
    margin: 0 0 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--lime);
  }

  .qn-sec-note {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
  }

  /* ---- WHOAMI：简介正文 ---- */
  .qn-prose p {
    margin: 0 0 16px;
    font-size: 15px;
  }

  .qn-prose p:last-child {
    margin-bottom: 0;
  }

  /* ---- CERTS：证书墙网格，窄屏自动换列 ---- */
  .qn-certs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px 16px;
  }

  .qn-cert {
    margin: 0;
  }

  .qn-cert img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff; /* 证书为白底扫描件，暗色页面上原样呈现 */
  }

  .qn-cert figcaption {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-dim);
    overflow-wrap: anywhere; /* 证书全称较长，允许在任意字符处换行 */
  }

  /* ---- HISTORY：日志流 ---- */
  .qn-log {
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 2.1;
    list-style: none;
  }

  .qn-log-time {
    margin-right: 10px;
    color: var(--lime);
  }

  /* ---- 移动端：标题与间距收缩 ---- */
  @media (max-width: 768px) {
    .qn-about {
      padding-top: 32px;
    }

    .qn-title {
      font-size: 22px;
    }

    .qn-block {
      margin-top: 32px;
    }

    .qn-certs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
