// 只取电话；whatsapp / 个人 GitHub / Twitter 等模板作者遗留字段禁止带入新站。
const PHONE = '0311-83937882';

// `$ agent --stack` 面板输出（设计稿 §9.3 原文口径）：名称 + 一句话说明
const STACK = [
  { name: 'LLM API', note: '大模型接入与提示词工程' },
  { name: 'RAG', note: '企业知识库检索增强，答案附出处' },
  { name: 'Function Calling', note: '工具调用，让 Agent 真正去查数据、办业务' },
  { name: '工作流引擎', note: '把多步骤业务流程编排成 Agent 可执行的链路' },
];
