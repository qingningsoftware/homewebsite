    <!-- 底部 CTA：电话 + /contact/（与产品页同源电话常量） -->
    <section class="qn-block qn-cta">
      <h2 class="qn-sec">CONTACT</h2>
      <p class="qn-cta-line">
        电话咨询 Agent 落地方案：<a class="qn-tel" href={`tel:${PHONE}`}>{PHONE}</a>
        <span class="qn-cta-dim">（工作日 9:00–18:00）</span>
      </p>
      <p class="qn-cta-line">
        <a class="qn-cta-link" href="/contact/">→ /contact/ 留言或扫码联系</a>
      </p>
    </section>
  </main>
</Base>

<script>
  import { typeLines } from '../scripts/typewriter';

  /**
   * 对话回放增强：滚动进视口时对 [data-qn-replay] 容器逐行打字（一次，不重复）。
   * 与首页产品回放同手法：正文已服务端直出——无 JS / reduced-motion / 不支持
   * IntersectionObserver 时不加任何状态类，全部静态显示。
   */
  const reduce =
    typeof window.matchMedia === 'function' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target); // 进场触发一次，不重复
          void play(entry.target as HTMLElement);
        }
      },
      { threshold: 0.2 },
    );
    document.querySelectorAll<HTMLElement>('[data-qn-replay]').forEach((el) => io.observe(el));
  }

  /** 打一段回放：收集直出行主文本（首个文本节点）→ 加打字态 → typeLines → 复原 */
  async function play(container: HTMLElement): Promise<void> {
    const lines = Array.from(
      container.querySelectorAll<HTMLElement>(':scope > [data-line]'),
    ).map((el) => {
      const first = el.firstChild;
      // 行主文本 = 首个文本节点；行内装饰（code 调用名等）不参与打字
      return first && first.nodeType === 3 ? (first.textContent ?? '') : (el.textContent ?? '');
    });
    container.classList.add('qn-typing');
    await typeLines(container, lines, { cps: 40 });
    container.classList.remove('qn-typing');
    container.classList.add('qn-done');
  }
</script>

<style>
  .qn-ag {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  .qn-crumbs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 32px;
  }

  .qn-chere {
    color: var(--text);
  }

  .qn-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.3;
  }

  .qn-intro {
    margin: 10px 0 0;
    font-size: 16px;
    color: var(--text-dim);
  }

  /* man 手册式段头：等宽加粗，下衬 1px 分隔线（与产品页一致） */
  .qn-sec {
    margin: 0 0 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--lime);
  }

  .qn-block {
    margin-top: 44px;
  }

  .qn-text {
    margin: 0 0 16px;
    font-size: 15px;
  }

  .qn-dim {
    color: var(--text-dim);
    font-size: 14px;
  }

  /* ---- 线一/线二 交付形态清单 ---- */
  .qn-dl {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .qn-dl li {
    padding: 10px 14px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .qn-dl li + li {
    margin-top: 10px;
  }

  .qn-dl strong {
    font-weight: 700;
  }

  /* ---- 回放窗口：纵排两个终端窗口 ---- */
  .qn-showcase {
    display: grid;
    gap: 24px;
  }

  .qn-replay {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 2.1;
  }

  .qn-rhead {
    margin: 0 0 8px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .qn-replay p {
    margin: 0;
  }

  .qn-c-user {
    color: var(--lime);
    word-break: break-all;
  }

  /* ◆ 思考中：标记用 ::before 挂出（不占行文本节点，打字只打「思考中」），
     呼吸动效 reduced-motion 下由全局总闸停为静态 */
  .qn-c-think {
    color: var(--text-dim);
  }

  .qn-c-think::before {
    content: '◆ ';
    color: var(--warning);
    animation: qn-think-pulse 1.2s ease-in-out infinite alternate;
  }

  /* keyframes 随 scoped 样式重命名，须在本组件内定义（不可跨组件引用） */
  @keyframes qn-think-pulse {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.4;
    }
  }

  .qn-c-tool {
    color: var(--text);
  }

  .qn-c-tool code {
    color: var(--lime);
    font-size: 13px;
  }

  /* 工具返回的结果卡片 */
  .qn-c-card {
    margin: 10px 0;
    padding: 10px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-left: 2px solid var(--lime);
    border-radius: 4px;
  }

  .qn-c-card-title {
    color: var(--text-dim);
    font-size: 12px;
  }

  .qn-c-card ol {
    margin: 4px 0 0;
    padding-left: 20px;
    font-size: 13px;
    line-height: 1.9;
  }

  .qn-c-final {
    color: var(--text);
  }

  /* ---- 打字增强状态（脚本加 .qn-typing / 行 .qn-done / data-typing） ----
     无 JS / reduced-motion 时这些类不存在，内容原样静态显示 */
  .qn-replay.qn-typing .qn-c-tool:not(.qn-done) code {
    visibility: hidden; /* 工具调用名等行打完再亮出（与首页尾注同手法） */
  }

  .qn-replay.qn-typing .qn-c-card {
    visibility: hidden; /* 结果卡片等前置「调用工具」行打完再亮出 */
  }

  .qn-replay.qn-typing .qn-c-tool.qn-done + .qn-c-card {
    visibility: visible;
  }

  .qn-replay [data-typing]::after {
    content: '▊';
    color: var(--lime);
    animation: qn-blink 0.9s steps(1) infinite;
  }

  @keyframes qn-blink {
    50% {
      opacity: 0;
    }
  }

  /* ---- $ agent --stack 输出清单 ---- */
  .qn-stack {
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 2.1;
    list-style: none;
  }

  .qn-stack li::before {
    content: '✓ ';
    color: var(--success);
  }

  .qn-stack-note {
    color: var(--text-dim);
    font-size: 13px;
  }

  /* ---- CONTACT CTA：电话 + /contact/ ---- */
  .qn-cta {
    padding: 20px 18px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .qn-cta-line {
    margin: 0;
    font-size: 15px;
  }

  .qn-cta-line + .qn-cta-line {
    margin-top: 8px;
  }

  .qn-tel {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .qn-cta-link {
    font-weight: 600;
  }

  .qn-cta-dim {
    color: var(--text-dim);
    font-size: 13px;
  }

  /* ---- 移动端：标题与间距收缩 ---- */
  @media (max-width: 768px) {
    .qn-ag {
      padding-top: 32px;
    }

    .qn-title {
      font-size: 22px;
    }

    .qn-block {
      margin-top: 32px;
    }
  }
</style>
