    <!-- 技术栈面板：$ agent --stack（设计稿 §9.3 原文口径） -->
    <section class="qn-block">
      <h2 class="qn-sec">技术栈</h2>
      <TermWindow title="$ agent --stack">
        <ul class="qn-stack">
          {
            STACK.map(({ name, note }) => (
              <li>
                {name}
                <span class="qn-stack-note">{` —— ${note}`}</span>
