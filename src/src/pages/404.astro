---
/**
 * 404 页：command not found 风格（设计稿 §4 / 实施计划任务 11）
 *
 * 终端窗口直出一条报错回放：`~ ❯ 打开的页面` → `bash: 打开的页面: command not found`，
 * 配一句中文提示，下方给返回首页与常用链接（产品 / 留言墙 / 联系我们）。
 * 静态站拿不到用户实际访问的路径，回放里用占位命令「打开的页面」示意，
 * 全部内容服务端直出、无客户端脚本（GEO 要求，设计稿 §8）。
 *
 * title/description 含「404」「未找到」且每页唯一，由 Base 直出。
 */
import Base from '../layouts/Base.astro';
import TermWindow from '../components/TermWindow.astro';

// 常用出口（设计稿 §4 信息架构）：返回首页 + 产品 / 留言墙 / 联系我们
const exits = [
  { href: '/', label: '返回首页', main: true },
  { href: '/products/', label: '产品', main: false },
  { href: '/wall/', label: '留言墙', main: false },
  { href: '/contact/', label: '联系我们', main: false },
] as const;
---

<Base
  title="页面未找到（404）— 石家庄青柠软件技术有限公司"
  description="您访问的页面未找到（404）：这条地址没有对应的页面。可返回青柠软件官网首页，或前往产品、留言墙与联系我们。"
  pageName="404"
>
  <main class="qn-404">
    <!-- 面屑：~ / 404 -->
    <nav class="qn-crumbs" aria-label="面包屑">
      <a href="/">~</a><span class="qn-csep" aria-hidden="true"> / </span
      ><span class="qn-chere">404</span>
    </nav>

    <h1 class="qn-title">404 · 页面未找到</h1>
    <p class="qn-intro">像敲了一条不存在的命令——别急，常用出口都在下面。</p>

    <!-- 报错回放：命令回显 → bash 报错，全部服务端直出 -->
    <section class="qn-block">
      <TermWindow title="qn@qingning:~">
        <p class="qn-echo">
          <span class="qn-prompt" aria-hidden="true">~ ❯ </span>打开的页面
        </p>
        <p class="qn-err">bash: 打开的页面: command not found</p>
        <p class="qn-hint">这条命令没有对应的页面：地址可能拼错了，或者内容已经搬家。</p>
      </TermWindow>
    </section>

    <!-- 常用出口：返回首页为主，产品 / 留言墙 / 联系我们并列 -->
    <nav class="qn-exits" aria-label="常用页面">
      {
        exits.map((item) => (
          <a class:list={['qn-exit', { 'qn-exit-main': item.main }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </main>
</Base>

<style>
  .qn-404 {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  .qn-crumbs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 32px;
  }

  .qn-chere {
    color: var(--text);
  }

  .qn-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.3;
  }

  .qn-intro {
    margin: 10px 0 32px;
    font-size: 15px;
    color: var(--text-dim);
  }

  /* ---- 报错回放：命令回显青柠绿，报错行用语义错误红 ---- */
  .qn-echo {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--lime);
    overflow-wrap: anywhere;
  }

  .qn-prompt {
    color: var(--text-dim);
  }

  .qn-err {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--error);
    overflow-wrap: anywhere;
  }

  .qn-hint {
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--text-dim);
  }

  /* ---- 常用出口：等宽描边按钮一排，主出口（返回首页）青柠描边加重 ---- */
  .qn-exits {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .qn-exit {
    padding: 8px 18px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
  }

  .qn-exit:hover {
    border-color: var(--lime);
    color: var(--lime-hover);
  }

  .qn-exit-main {
    border-color: var(--lime);
    color: var(--lime);
    font-weight: 700;
  }

  .qn-exit-main:hover {
    color: var(--lime-hover);
  }

  /* ---- 移动端：标题与间距收缩，出口按钮可换行 ---- */
  @media (max-width: 768px) {
    .qn-404 {
      padding-top: 32px;
    }

    .qn-title {
      font-size: 22px;
    }
  }
</style>
