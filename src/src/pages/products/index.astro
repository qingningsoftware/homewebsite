---
/**
 * 产品目录页：ls -la 风格目录（设计稿 §7 / 实施计划任务 8 Step 3）
 *
 * 每产品一行：装饰权限列、YEAR（上线年份）、NAME（链接到详情页）、DESCRIPTION（一句话定位）。
 * mnp 无图标（frontmatter icon 为空串），该行不显图标。
 * GEO：目录全部服务端直出；title/description 由 Base 直出。
 */
import { getCollection } from 'astro:content';
import { Image, type ImageMetadata } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TermWindow from '../../components/TermWindow.astro';

// 图标文件名存于 frontmatter，构建期 glob 一次性解析到图片模块
const icons = import.meta.glob<{ default: ImageMetadata }>('../../../assets/icons/*.png');

// 按 order 排序（1 起，越小越靠前）
const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);

// icon 为空串（无图标）则该行不渲染图标
const rows = await Promise.all(
  products.map(async (p) => {
    const module = p.data.icon ? icons[`../../../assets/icons/${p.data.icon}`] : undefined;
    return { p, icon: module ? (await module()).default : undefined };
  }),
);
---

<Base title="产品 — 石家庄青柠软件技术有限公司" description="青柠软件产品目录：智尚通行智慧社区平台、远程医疗 PACS 系统、高考一站志愿、企业安全培训平台、变电所模拟屏、移动支付平台，覆盖智慧社区、医疗影像、教育、交通支付、电力培训等行业。" pageName="产品">
  <main class="qn-ls">
    <!-- 面屑：~ / products -->
    <nav class="qn-crumbs" aria-label="面包屑">
      <a href="/">~</a><span class="qn-csep" aria-hidden="true"> / </span
      ><span class="qn-chere">products</span>
    </nav>

    <h1 class="qn-sr">青柠软件产品目录</h1>
    <p class="qn-intro">
      共 {products.length} 个产品，覆盖智慧社区、医疗影像、教育、交通支付、电力培训等行业。
    </p>

    <TermWindow title="qn@qingning:~ $ ls -la /products/">
      <table class="qn-table">
        <caption class="qn-sr">
          青柠软件产品列表：MODE 为装饰权限列，YEAR 为上线年份，NAME 链接到产品详情页，DESCRIPTION 为一句话定位
        </caption>
        <thead>
          <tr>
            <th scope="col">MODE</th>
            <th scope="col">YEAR</th>
            <th scope="col">NAME</th>
            <th scope="col">DESCRIPTION</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ p, icon }) => (
              <tr>
                <td class="qn-mode">drwxr-xr-x</td>
                <td class="qn-year">{p.data.year}</td>
                <td class="qn-name">
                  {icon && (
                    <Image
                      src={icon}
                      alt=""
                      width={20}
                      densities={[1, 2]}
                      format="webp"
                      loading="lazy"
                      class="qn-licon"
                    />
                  )}
                  <a href={`/products/${p.id}/`}>{`${p.data.name}/`}</a>
                </td>
                <td class="qn-desc">{p.data.oneLiner}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="qn-total" aria-hidden="true">total {products.length}</p>
    </TermWindow>
  </main>
</Base>

<style>
  .qn-ls {
    max-width: 1020px;
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  .qn-crumbs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 32px;
  }

  .qn-chere {
    color: var(--text);
  }

  .qn-intro {
    margin: 10px 0 28px;
    font-size: 15px;
    color: var(--text-dim);
  }

  /* ---- ls -la 目录表：等宽、行分隔、hover 高亮 ---- */
  .qn-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .qn-table th,
  .qn-table td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .qn-table thead th {
    color: var(--text-dim);
    font-weight: 400;
    font-size: 12px;
  }

  .qn-table tbody tr:hover {
    background: var(--row-hover);
  }

  .qn-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .qn-mode {
    color: var(--text-dim);
    white-space: nowrap;
  }

  .qn-year {
    color: var(--lime);
    white-space: nowrap;
  }

  .qn-name {
    white-space: nowrap;
  }

  /* 行内小图标：有图标才渲染（mnp 无图标） */
  .qn-licon {
    display: inline-block;
    width: 20px;
    height: 20px;
    object-fit: contain;
    vertical-align: -4px;
    margin-right: 8px;
  }

  .qn-desc {
    color: var(--text-dim);
  }

  .qn-total {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
  }

  /* ---- 无障碍：仅供爬虫与读屏 ---- */
  .qn-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- 移动端：DESCRIPTION 列允许换行，窄屏不横向撑破 ---- */
  @media (max-width: 768px) {
    .qn-ls {
      padding-top: 32px;
    }

    .qn-table th,
    .qn-table td {
      padding: 8px 8px;
    }

    .qn-desc {
      white-space: normal;
      min-width: 180px;
    }
  }
</style>
