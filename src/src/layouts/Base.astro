---
/**
 * 全站基础布局：head 元数据直出 + tmux 状态栏 + 扫描线覆盖层
 * GEO 要求（设计稿 §8）：title/description/canonical/Open Graph 全部服务端直出
 */
import '../styles/global.css';
import TmuxBar from '../components/TmuxBar.astro';
import { type ImageMetadata } from 'astro:assets';

/**
 * 百度统计 ID（设计稿 §8.8，全站唯一第三方脚本）：
 * 公司侧提供后填入此处，部署文档会写明填写位置；留空时不输出统计脚本，
 * 避免向 hm.baidu.com 发出无效请求。
 */
export const BAIDU_TONGJI_ID = '';

interface Props {
  /** 页面标题（每页唯一） */
  title: string;
  /** 页面描述（每页唯一） */
  description: string;
  /** 当前页名，显示在 tmux 状态栏窗口列表（默认「主站」） */
  pageName?: string;
}

const { title, description, pageName = '主站' } = Astro.props;

// canonical = 站点基准域名 + 当前路径
const canonical = new URL(Astro.url.pathname, Astro.site);

// og:image（GEO 要求，设计稿 §8.5）：全站用智慧社区 banner，构建期解析为绝对 URL
const banners = import.meta.glob<{ default: ImageMetadata }>('../../assets/banners/*.png');
const smartBanner = banners['../../assets/banners/smart-community.png'];
const smartBannerImg = smartBanner ? (await smartBanner()).default : undefined;
const ogImage = smartBannerImg ? new URL(smartBannerImg.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="石家庄青柠软件技术有限公司" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <TmuxBar pageName={pageName} />
    <div class="scanlines" aria-hidden="true"></div>
    {
      // 百度统计：异步加载（ID 填入 BAIDU_TONGJI_ID 后才会输出本脚本）
      BAIDU_TONGJI_ID && (
        <script is:inline async src={`https://hm.baidu.com/hm.js?${BAIDU_TONGJI_ID}`} />
      )
    }
  </body>
</html>
